# Copy to .env and fill in.

# --- Slack app ---
# Bot token (xoxb-…). Scopes: chat:write, channels:history, groups:history,
# reactions:read, usergroups:read, users:read, users:read.email
SLACK_BOT_TOKEN=
# Signing secret — verifies inbound events. Strongly recommended.
SLACK_SIGNING_SECRET=

# --- What to watch ---
# Comma-separated Slack usergroup (subteam) IDs whose mention triggers a timer.
# Find IDs via: curl -s -H "Authorization: Bearer $TOKEN" https://slack.com/api/usergroups.list | jq '.usergroups[]|{id,handle}'
WATCH_USERGROUP_IDS=S0123ABCD
# Optional: also trigger on literal text (comma-separated). Usually leave blank.
WATCH_KEYWORDS=

# --- Timing ---
ACK_TIMEOUT=30m

# --- Escalation target(s) ---
# Comma-separated. Each entry: a usergroup id (S…), a user id (U…), or an email.
ESCALATION_TARGETS=S0DEVOPSALL

# --- Who may acknowledge (union; leave ALL blank to accept anyone) ---
RESPONDER_USERGROUP_IDS=S0123ABCD
RESPONDER_USER_IDS=
RESPONDER_EMAILS=

# --- What counts as an ack ---
# Any thread reply from a member of a watched (on-call) usergroup counts as an
# ack — they've clearly engaged. Set false to require an explicit keyword/emoji.
ACK_ANY_ONCALL_REPLY=true
# Named people whose ANY thread reply acks, whatever the wording. Narrower than
# ACK_ANY_ONCALL_REPLY and independent of it: this list survives rota changes.
# e.g. two always-on responders, independent of the rotation.
ACK_ANY_REPLY_USER_IDS=U0EXAMPLE1,U0EXAMPLE2
# Reply phrases and reaction emojis (wide defaults are baked in; override to tune).
# Custom workspace emoji work too — include their shortcode without colons for
# reactions (e.g. on-it-dani) and with colons for typed replies (e.g. :on-it-dani:).
# ACK_KEYWORDS=ack,looking,on it,taking,investigating,:ack:,:on-it-dani:,:eyes:
# ACK_EMOJIS=white_check_mark,eyes,+1,raised_hand,ack,on-it-dani
